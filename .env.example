# Khai báo các biến này trong cPanel → Setup Node.js App → Environment variables (hoặc .env trên VPS)
PORT=3000
NODE_ENV=production
SITE_URL=https://phinfit.com

# Trang quản trị /admin (bắt buộc đặt để bật)
ADMIN_USER=admin
ADMIN_PASS=doi-mat-khau-manh

# Chuyển khoản VietQR (để trống => ẩn mã QR)
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# Phí ship (VND). Để trống => "xác nhận khi gọi chốt đơn"
